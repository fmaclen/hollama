{
	"name": "hollama",
	"version": "0.36.3",
	"private": true,
	"homepage": "https://hollama.fernando.is",
	"description": "A minimal LLM chat app that runs entirely in your browser",
	"scripts": {
		"dev": "vite dev --host",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"test": "playwright test --trace on --ignore-snapshots ",
		"check": "paraglide-js compile --project ./project.inlang && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "paraglide-js compile --project ./project.inlang && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"electron": "electron .",
		"electron:build": "cross-env PUBLIC_ADAPTER=electron-node vite build && electron-builder",
		"i18n:check": "inlang check --project ./project.inlang --missing-translations --no-fail"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/cli": "^3.4.5",
		"@inlang/paraglide-js": "^2.29.3",
		"@lucide/svelte": "^1.52.0",
		"@playwright/test": "^1.63.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.10",
		"@semantic-release/npm": "^13.2.0",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
		"@types/semver": "^7.8.0",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^0.22.0",
		"codemirror": "^6.0.2",
		"cross-env": "^10.1.0",
		"dotenv": "^18.0.5",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.13.0",
		"highlight.js": "^11.12.0",
		"katex": "^0.19.0",
		"markdown-it": "^15.0.2",
		"markdown-it-texmath": "^1.0.0",
		"ollama": "^0.6.4",
		"openai": "^7.28.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^25.0.9",
		"semver": "^7.8.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-scrollbar": "^3.1.0",
		"tailwindcss": "^3.4.19",
		"thememirror": "^2.0.1",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vite-node": "^6.0.0",
		"wrangler": "^4.147.0"
	},
	"type": "module",
	"author": {
		"name": "Fernando Maclen",
		"email": "hello@fernando.is",
		"url": "https://fernando.is"
	},
	"main": "./electron/main.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
