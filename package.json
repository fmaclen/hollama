{
	"name": "hollama",
	"version": "0.35.4",
	"private": true,
	"homepage": "https://hollama.fernando.is",
	"description": "A minimal LLM chat app that runs entirely in your browser",
	"scripts": {
		"dev": "concurrently \"typesafe-i18n\" \"vite dev --host\"",
		"build": "svelte-kit sync && vite build",
		"preview": "vite preview",
		"test": "playwright test --trace on --ignore-snapshots ",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"electron": "electron .",
		"electron:build": "cross-env PUBLIC_ADAPTER=electron-node vite build && electron-builder",
		"typesafe-i18n": "typesafe-i18n"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@playwright/test": "^1.63.0",
		"@semantic-release/commit-analyzer": "^11.1.0",
		"@semantic-release/git": "^10.0.1",
		"@semantic-release/github": "^9.2.6",
		"@semantic-release/npm": "^11.0.3",
		"@semantic-release/release-notes-generator": "^12.1.0",
		"@sveltejs/adapter-cloudflare": "^6.0.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^5.1.1",
		"@tailwindcss/nesting": "^0.0.0-insiders.565cd3e",
		"@types/markdown-it": "^14.2.0",
		"@types/semver": "^7.8.0",
		"autoprefixer": "^10.6.1",
		"bits-ui": "^0.22.0",
		"codemirror": "^6.0.2",
		"concurrently": "^8.2.2",
		"cross-env": "^7.0.3",
		"date-fns": "^3.6.0",
		"dotenv": "^16.6.1",
		"electron": "^31.7.7",
		"electron-builder": "^25.1.8",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^16.5.0",
		"highlight.js": "^11.12.0",
		"katex": "^0.16.47",
		"lucide-svelte": "^0.509.0",
		"markdown-it": "^14.3.2",
		"markdown-it-texmath": "^1.0.0",
		"ollama": "^0.5.18",
		"openai": "^4.104.0",
		"postcss": "^8.5.29",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^3.5.2",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"semantic-release": "^23.1.1",
		"semver": "^7.8.5",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^0.3.28",
		"tailwind-scrollbar": "^3.1.0",
		"tailwindcss": "^3.4.19",
		"thememirror": "^2.0.1",
		"typesafe-i18n": "^5.27.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^6.4.3",
		"vite-node": "^3.2.4"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "^4.64.0",
		"@sveltejs/adapter-cloudflare": "^6.0.1"
	},
	"type": "module",
	"author": {
		"name": "Fernando Maclen",
		"email": "hello@fernando.is",
		"url": "https://fernando.is"
	},
	"main": "./electron/main.js",
	"dependencies": {
		"wrangler": "^4.147.0"
	}
}
